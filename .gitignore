# SQL Workspace .gitignore
# Ignore backup files
backup/
*.bak

# Ignore VS Code user-specific settings (but keep project settings)
.vscode/*.code-workspace
# Keep these project configuration files:
# .vscode/settings.json
# .vscode/extensions.json
# .vscode/launch.json
# .vscode/CONFIGURACION_SQL.md

# Ignore system files
Thumbs.db
.DS_Store
sql_proyectos.code-workspace

# Ignore logs
*.log

# Ignore temp files
*.tmp
~$*

# Ignore compiled files
*.class
*.exe
*.dll
*.obj
*.o

# Ignore Python cache (if any)
__pycache__/
*.pyc
*.pyo

# Ignore node_modules (if any)
node_modules/
